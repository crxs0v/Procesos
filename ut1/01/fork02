#include <stdlib.h>
#include <unistd.h>
#include <stdio.h>
#include <sys/types.h>
#include <sys/wait.h>

int main() {
  pid_t pid;

  pid = fork();

  if (pid == -1) 
  {
    printf("ERROR !!! No se ha podido crear el proceso hijo...\n");
    exit(-1);       
  }
  
  if (pid == 0)  // a) El proceso HIJO muestra el nombre del alumno
  {        
    printf("Soy el proceso HIJO\n");     
    printf("Nombre del alumno: Cristina Pullupaxi\n"); 
  }
  else   
  { 
    wait(NULL); // Espera a que el hijo termine
    
    printf("\nSoy el proceso PADRE\n");
    printf("Mi PID es: %d\n", getpid());
    printf("Mi hijo tenía el PID: %d\n", pid); 
    printf("El proceso hijo ha terminado\n");          
  }
  
  exit(0);
}
